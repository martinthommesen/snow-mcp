# ─── ServiceNow Code Mode MCP — local secrets template ───────────────────────
# Copy to `.dev.vars` (git-ignored) and fill in. NEVER commit the real file.
# Generate 256-bit base64 keys with:  openssl rand -base64 32
# See docs/FORK.md (quick-start) and docs/DESIGN.md (architecture + bindings).

# --- ServiceNow instance + OAuth (confidential client: Auth Code + PKCE + secret, §2.8) ---
SNOW_INSTANCE_HOST="dev000000.service-now.com"
SNOW_OAUTH_CLIENT_ID=""
SNOW_OAUTH_CLIENT_SECRET=""          # confidential client — required where refresh tokens are needed (§2.8, B9)
# Dev/CI only: ROPC (MFA-exempt) for a disposable PDI service identity. Leave unset in prod.
SNOW_DEV_ROPC="0"
SNOW_DEV_ROPC_USERNAME=""
SNOW_DEV_ROPC_PASSWORD=""

# --- MCP-client OAuth provider (§2.4) ---
OAUTH_PROVIDER_SECRET=""             # signing/encryption secret for @cloudflare/workers-oauth-provider
AUTH_MODE="operator_secret"          # "operator_secret" (pilot/dev) | "oidc" (enterprise identity)
OIDC_ISSUER=""                       # issuer URL when AUTH_MODE=oidc
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_SCOPES="openid profile email offline_access" # offline_access lets the Worker refresh and re-check groups before MCP refresh tokens are renewed.
OIDC_GROUP_CLAIM="groups"
OIDC_GROUP_POLICY_MAP=""             # JSON: {"group":{"maxMode":"write","policy":"default"}}
OIDC_DEFAULT_POLICY_NAME="default"

# --- Encryption keys (§2.7, §7.7) ---
TOKEN_KEK=""                         # one-release alias for TOKEN_KEK_CURRENT (P3 migration)
SNAPSHOT_KEK=""                      # one-release alias for SNAPSHOT_KEK_CURRENT (P3 migration)
# Versioned KEK ring (P3): set CURRENT = today's passphrase on first deploy; rotate later by
# moving CURRENT -> PREV and setting a new CURRENT (both decrypt during the window).
TOKEN_KEK_CURRENT=""                 # AES-256-GCM KEK for TokenStoreDO token envelopes (current)
TOKEN_KEK_PREV=""                    # accepted during a rotation window (optional)
SNAPSHOT_KEK_CURRENT=""              # AES-256-GCM KEK for recovery snapshots (current)
SNAPSHOT_KEK_PREV=""                 # accepted during a rotation window (optional)

# --- Deployment posture + mode / credential config (P5/P6) ---
DEPLOYMENT_PROFILE="pilot"           # "pilot" preserves today's permissive defaults; "production" enables fail-closed preflight
SERVICENOW_CREDENTIAL_MODE=""        # "per_user_oauth" | "integration_user" (default integration_user)
TENANT_MAX_MODE=""                   # mode ceiling: read_only | write | admin_script (default admin_script)
INSTANCE_MAX_MODE=""                 # mode ceiling: read_only | write | admin_script (default admin_script)
ALLOW_ADMIN_SCRIPT_CEILING=""        # production only: "true" deliberately permits an admin_script tenant/instance ceiling
SNOW_EXECUTOR_VERIFIER_ATTESTED=""   # production only: "true" after target-family executor verifier/live gates pass
ALLOW_LOCALHOST=""                   # "true" to allow http://localhost Origin (dev only; default false)
ALLOWED_ORIGINS=""                   # comma-separated allowed Origins for /mcp and auth-surface requests
WORKER_PUBLIC_ORIGIN=""              # canonical https://<worker> origin; required for per_user_oauth redirect/ticket URLs

# --- Recovery snapshots + second-approval gate (P4) ---
SNAPSHOT_ENABLED_TABLES=""           # comma-separated tables that get before/after recovery snapshots (empty = none)
# admin_script second-approval policy (§7.9). Empty settings deny admin_script; configure an
# allowlisted actor plus either a valid approval token or a required access group to permit it.
ADMIN_SCRIPT_ALLOWLIST=""            # comma-separated actor userIds permitted admin_script
ADMIN_SCRIPT_APPROVAL_TOKENS=""      # comma-separated valid approval tokens
ADMIN_SCRIPT_REQUIRED_GROUP=""       # required access-group name (token OR group satisfies the second approval)

# --- Restrictive ActorPolicy (§6b) ---
# PILOT: leave ALL empty to keep the permissive single-operator default. PRODUCTION:
# configure a restrictive host-side policy or the production posture preflight fails closed.
# The values below are a RECOMMENDED conservative example (commented out) — uncomment + tailor
# per tenant. A self-defeating mandatory row filter (one containing ^NQ/^OR/^EQ) is REJECTED at load.
# ACTOR_POLICY_TABLE_ALLOWLIST="incident,problem,change_request,task,sc_request"   # only these tables (whole-name match)
# ACTOR_POLICY_FIELD_MASKS="incident:caller_id,u_ssn;sys_user:vip"                  # table:field,field;table:field (stripped from reads, rejected on writes; dot-aware)
# ACTOR_POLICY_ROW_FILTERS="incident:active=true"                                   # table:encodedQuery;table:encodedQuery (AND-ed into every read; no ^NQ/^OR/^EQ)
# ACTOR_POLICY_MAX_ROWS_PER_RUN="10000"                                             # per-run row ceiling (RunBudget enforces → budget_exceeded)
# ACTOR_POLICY_MAX_BYTES_PER_RUN="5000000"                                          # per-run byte ceiling
# ACTOR_POLICY_MAX_MODE="read_only"                                                 # flat default policy max mode (read_only | write | admin_script)
# ACTOR_POLICIES_JSON='{"default":{"ACTOR_POLICY_TABLE_ALLOWLIST":"incident","ACTOR_POLICY_MAX_MODE":"read_only"},"admin":{"ACTOR_POLICY_TABLE_ALLOWLIST":"incident,problem","ACTOR_POLICY_MAX_MODE":"write"}}'

# --- Executor actor-signing HMAC (§2.0) ---
# Mirror this value to the ServiceNow property `x_1793136_mcp.executor.hmac_secret` on the instance.
X_MCP_EXECUTOR_HMAC_KEY=""

# Single-operator consent secret for the MCP OAuth flow (§2.4)
MCP_OPERATOR_SECRET=""
MCP_OPERATOR_USER_ID=""              # required stable MCP actor subject for consent grants
MCP_OPERATOR_EMAIL=""                # optional actor email stored in OAuth props / audit identity
MCP_OPERATOR_ACCESS_GROUPS=""        # optional comma-separated groups for admin_script second approval

# Executor endpoint path (instance-specific; global-scope APIs get a numeric namespace)
SNOW_EXECUTOR_PATH=""
