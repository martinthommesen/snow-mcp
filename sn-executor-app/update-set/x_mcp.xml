<?xml version="1.0" encoding="UTF-8"?>
<!--
  x_mcp executor — production scoped-app update set SCAFFOLD (plan §10).

  ⚠️ This is a hand-authored SCAFFOLD, not a Studio export. ServiceNow assigns real
  sys_ids and dictionary collection records at build time, so the AUTHORITATIVE delivery
  is: build the scoped app `x_mcp` in a PDI's Studio using the artifacts in this folder,
  then EXPORT the update set over this file. The mechanism is already PROVEN end-to-end
  via scripts/executor-install.mjs (global-scope REST install, 7/7: B1/B6/S9/S16/T8) — see
  sn-executor-app/INSTALL.md. This scaffold documents the production scoped-app records the
  REST install can't create (custom tables + the x_mcp.executor role + REST_Endpoint ACL).

  Records (build these in Studio, scope = x_mcp):
  1. sys_scope            — application "MCP Executor" (scope x_mcp)
  2. sys_user_role        — x_mcp.executor, x_mcp.admin (admin ≠ integration user)
  3. sys_db_object        — x_mcp_audit_log, x_mcp_nonce  (+ sys_dictionary columns below)
  4. sys_script_include   — x_mcp_verify  (source: ../script-include/x_mcp_verify.js)
  5. sys_ws_definition    — x_mcp  (Scripted REST API)
  6. sys_ws_operation     — executor/run (POST)  (source: ../scripted-rest/x_mcp.executor.run.js)
  7. sys_security_acl      — REST_Endpoint ACL on the operation requiring x_mcp.executor,
                             replacing the default "Scripted REST External Default" (snc_internal)
  8. sys_security_acl      — x_mcp_audit_log read/write -> x_mcp.admin ONLY (executor cannot
                             read/alter other rows; §10, §12)
  9. sys_properties       — x_mcp.executor.enabled, .run_server_script_enabled, .max_bytes,
                             .max_output_bytes, .timeout_ms, .hmac_secret (=X_MCP_EXECUTOR_HMAC_KEY),
                             .hmac_secret_prev
-->
<unload unload_date="2026-05-31 00:00:00">

  <!-- 1. Application scope -->
  <sys_scope action="INSERT_OR_UPDATE">
    <name>MCP Executor</name>
    <scope>x_mcp</scope>
    <short_description>Attributable, audited, kill-switchable arbitrary server-side script executor for the Code Mode MCP server.</short_description>
    <version>1.0.0</version>
  </sys_scope>

  <!-- 2. Roles -->
  <sys_user_role action="INSERT_OR_UPDATE">
    <name>x_mcp.executor</name>
    <description>The ONLY role allowed to hit the executor endpoint. May create/close its own audit row; cannot read/alter other rows, change properties, or grant roles.</description>
    <scoped_admin>false</scoped_admin>
  </sys_user_role>
  <sys_user_role action="INSERT_OR_UPDATE">
    <name>x_mcp.admin</name>
    <description>Manages x_mcp_audit_log, the kill-switch + egress properties, role assignments (separation of duty). MUST NOT be the integration user.</description>
  </sys_user_role>

  <!-- 3. Tables (define columns in Studio; sys_dictionary collection records are auto-created) -->
  <!-- x_mcp_audit_log: snow_user, snow_user_name, mcp_actor_user_id, mcp_actor_email,
       request_id, actor_verified(boolean), code_hash, code_size(int), started_at(glide_date_time),
       duration(int), status, output_size(int), error_class. NO script body, NO raw output. -->
  <!-- x_mcp_nonce: value (unique index), created (glide_date_time). TTL-pruned by a scheduled job. -->

  <!-- 4. Script Include x_mcp_verify — see ../script-include/x_mcp_verify.js for the source.
       Scoped form calls `new x_mcp.x_mcp_verify()`; HMAC via GlideCertificateEncryption.generateMac
       (PROVEN cross-engine-equal to the host WebCrypto signer, B1). -->

  <!-- 5/6. Scripted REST API x_mcp, resource executor/run (POST) — see
       ../scripted-rest/x_mcp.executor.run.js. requires_acl_authorization = TRUE so the ACL below
       gates it (the REST install used the HMAC signature as the sole gate; production adds the role). -->

  <!-- 7. REST_Endpoint ACL: operation execute on x_mcp/executor/run requires role x_mcp.executor. -->
  <sys_security_acl action="INSERT_OR_UPDATE">
    <name>x_mcp/executor/run</name>
    <operation>execute</operation>
    <type>rest_endpoint</type>
    <active>true</active>
    <admin_overrides>false</admin_overrides>
    <description>REST_Endpoint ACL requiring x_mcp.executor on the executor resource (replaces Scripted REST External Default).</description>
  </sys_security_acl>

  <!-- 8. Audit-table hardening: read/write on x_mcp_audit_log -> x_mcp.admin only. -->
  <sys_security_acl action="INSERT_OR_UPDATE">
    <name>x_mcp_audit_log</name>
    <operation>read</operation>
    <type>record</type>
    <active>true</active>
    <admin_overrides>false</admin_overrides>
  </sys_security_acl>

  <!-- 9. Properties (set hmac_secret = the Cloudflare secret X_MCP_EXECUTOR_HMAC_KEY). -->
  <sys_properties action="INSERT_OR_UPDATE"><name>x_mcp.executor.enabled</name><value>true</value><type>true|false</type></sys_properties>
  <sys_properties action="INSERT_OR_UPDATE"><name>x_mcp.executor.run_server_script_enabled</name><value>true</value><type>true|false</type></sys_properties>
  <sys_properties action="INSERT_OR_UPDATE"><name>x_mcp.executor.max_bytes</name><value>32768</value><type>integer</type></sys_properties>
  <sys_properties action="INSERT_OR_UPDATE"><name>x_mcp.executor.max_output_bytes</name><value>65536</value><type>integer</type></sys_properties>
  <sys_properties action="INSERT_OR_UPDATE"><name>x_mcp.executor.timeout_ms</name><value>30000</value><type>integer</type></sys_properties>
  <!-- hmac_secret / hmac_secret_prev are password2; set them on the instance, not in source control. -->

</unload>
