{
  // ServiceNow Code Mode MCP — Worker config (local dev + vitest-pool-workers).
  // Production infra is provisioned via alchemy.run.ts (§2.11); this file is the
  // source of truth for `wrangler dev --port 8787` and the test runtime.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "servicenow-codemode-mcp",
  "main": "src/index.ts",
  // Plan §2.9 — ONE compatibility date everywhere. See docs/DELTAS.md.
  "compatibility_date": "2026-05-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Plan §2.1 — Worker Loader binding; the executor calls load() (never v1 code directly).
  "worker_loaders": [{ "binding": "LOADER" }],

  // Plan §2.10 / §2.6 / §2.4 — KV namespaces, kept separate from TokenStoreDO.
  // ALL FOUR IDs below (SCHEMA_KV/OAUTH_KV/AUDIT_KV/SNAPSHOT_KV) are PLACEHOLDERS for
  // local/test only — vitest-pool-workers ignores IDs and uses in-memory KV. The real
  // namespaces are adopted-by-title in alchemy.run.ts at deploy time (adopt: true), so
  // these literal IDs are never the production bindings.
  // AUDIT_KV (host audit trail, §7.2) + SNAPSHOT_KV (recovery snapshots, §7.7) are
  // consumed once their flows are wired (P4); both are now live (P4 mutating path).
  "kv_namespaces": [
    { "binding": "SCHEMA_KV", "id": "40c98ca0d717428e89e097ef30887b8a" },
    { "binding": "OAUTH_KV", "id": "8de4edaad4d8481988a80be5edc77b46" },
    { "binding": "AUDIT_KV", "id": "397e4bc056e6c3b87b2351bd40c429c4" },
    { "binding": "SNAPSHOT_KV", "id": "5a947ee62cd17dafdcbcfd3dec762748" }
  ],

  "dev": {
    "port": 8787,
    "ip": "127.0.0.1"
  },

  // Plan §2.10 — purpose-split Durable Objects (skeletons in Phase 0.12; logic later).
  "durable_objects": {
    "bindings": [
      { "name": "AUTH_DO", "class_name": "AuthCorrelationDO" },
      { "name": "TOKEN_DO", "class_name": "TokenStoreDO" },
      { "name": "BUDGET_DO", "class_name": "BudgetDO" },
      { "name": "LEDGER_DO", "class_name": "MutationLedgerDO" },
      { "name": "CONSENT_RATE_DO", "class_name": "ConsentRateDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AuthCorrelationDO",
        "TokenStoreDO",
        "BudgetDO",
        "MutationLedgerDO"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ConsentRateDO"]
    }
  ],

  "vars": {
    // Local dev + vitest use the explicit pilot profile. Alchemy deploys only production.
    "DEPLOYMENT_PROFILE": "pilot"
  }

  // Secret bindings (§2.11: SNOW_*, OAUTH_PROVIDER_SECRET, TOKEN_KEK_CURRENT,
  // X_MCP_EXECUTOR_HMAC_KEY, SNAPSHOT_KEK_CURRENT) are provided via .dev.vars / `wrangler
  // secret put` and added to the typed Env as their flows are built.
}
