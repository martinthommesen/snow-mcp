{
  "name": "servicenow-codemode-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Code Mode MCP server for ServiceNow on Cloudflare Workers (stateless createMcpHandler).",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/mcp-server"
  ],
  "scripts": {
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "wrangler dev --port 8787 --config packages/mcp-server/wrangler.jsonc",
    "cf-types": "wrangler types --config packages/mcp-server/wrangler.jsonc",
    "live:verify": "bash scripts/live-rpc-verify.sh",
    "copy-wasm": "node -e \"require('fs').copyFileSync('node_modules/esbuild-wasm/esbuild.wasm','packages/mcp-server/src/sandbox/esbuild.wasm')\"",
    "check:verifier-sync": "node --check sn-executor-app/script-include/x_mcp_verify.js && node --check sn-executor-app/fluent/src/server/x_mcp_verify.js && node scripts/check-verifier-sync.mjs",
    "predev": "npm run copy-wasm",
    "pretest": "npm run copy-wasm && npm run check:verifier-sync",
    "deploy": "npm run copy-wasm && DEPLOYMENT_PROFILE=production alchemy deploy",
    "deploy:destroy": "ALCHEMY_DESTROY=1 alchemy destroy",
    "pilot:e2e": "node scripts/deployed-e2e.mjs",
    "production:oidc:e2e": "node scripts/deployed-oidc-e2e.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.16.10",
    "@cyclonedx/cyclonedx-npm": "4.2.1",
    "playwright": "1.60.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "4.95.0"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=20"
  }
}
